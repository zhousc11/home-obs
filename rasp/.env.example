# Required: must match PI_INGEST_TOKEN in dell/.env.
PI_INGEST_TOKEN=

# Dell incident receiver. DELL_INGEST_URLS accepts comma- or space-separated URLs.
DELL_INGEST_URL=
DELL_INGEST_URLS=http://192.168.66.152:8088/api/v1/pi-incident-events

# Set to a positive number to emit periodic snapshots while an incident is open.
SNAPSHOT_INTERVAL_SECONDS=0

# The agent directly receives EdgeRouter syslog over UDP.
SYSLOG_UDP_PORT=514

# Optional EdgeRouter diagnostic snapshot over SSH.
ERX_SSH_HOST=192.168.66.1
ERX_SSH_USER=
ERX_SSH_KEY_PATH=/data/erx_ssh_key
