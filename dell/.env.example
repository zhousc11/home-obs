# Required: use a unique strong password.
GRAFANA_ADMIN_PASSWORD=

# Keep Grafana authentication in front of the incident analysis endpoint.
REQUIRE_GRAFANA_AUTH=true

# Optional LLM analysis. Leave the API key empty to disable authenticated calls.
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=

# Required for authenticated event delivery from the Raspberry Pi.
# Use the exact same random value in rasp/.env.
PI_INGEST_TOKEN=
